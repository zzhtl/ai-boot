{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "status",
    "confidence",
    "summary",
    "commands",
    "corrections",
    "conflicts",
    "sections",
    "open_questions",
    "jira_keys"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "diagnosis",
        "summary",
        "howto",
        "other"
      ],
      "description": "任务类型"
    },
    "title": {
      "type": "string",
      "description": "卡片标题"
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "need_more_info",
        "partial"
      ],
      "description": "answered 已确认；partial 有依据的判断仍待验证；need_more_info 无可支持的判断且缺关键资料"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "主判断的证据把握；候选原因在正文分别标明可信程度，不编造概率"
    },
    "summary": {
      "type": "string",
      "description": "首屏概述，支持 Markdown 重点格式"
    },
    "commands": {
      "type": "array",
      "description": "本轮主操作，按执行顺序排列",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "where",
          "command",
          "look"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "命令用途"
          },
          "where": {
            "type": "string",
            "description": "执行位置"
          },
          "command": {
            "type": "string",
            "description": "完整命令"
          },
          "look": {
            "type": "string",
            "description": "观察或判断要点"
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "description": "相对此前答复的重要更正",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "description": "资料冲突与取舍",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "claim",
          "adopted",
          "sources"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "description": "冲突点"
          },
          "claim": {
            "type": "string",
            "description": "被否定的说法"
          },
          "adopted": {
            "type": "string",
            "description": "采信的内容与依据"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "由模型组织的折叠详情",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "Markdown 正文"
          },
          "images": {
            "type": "array",
            "description": "要展示的附件截图",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "caption"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "工作目录中的附件路径"
                },
                "caption": {
                  "type": "string",
                  "description": "图片说明"
                }
              }
            }
          },
          "charts": {
            "type": "array",
            "description": "数据图表",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "type",
                "categories",
                "series"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "bar",
                    "line",
                    "area",
                    "pie"
                  ],
                  "description": "图表类型"
                },
                "categories": {
                  "type": "array",
                  "description": "横轴类别",
                  "items": {
                    "type": "string"
                  }
                },
                "series": {
                  "type": "array",
                  "description": "图表系列",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "values"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "diagrams": {
            "type": "array",
            "description": "流程或依赖图",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "dot"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "dot": {
                  "type": "string",
                  "description": "Graphviz DOT 内容"
                }
              }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "影响结论或操作的待确认事项",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "description": "交付文件的工作目录相对路径",
      "items": {
        "type": "string"
      }
    },
    "jira_keys": {
      "type": "array",
      "description": "直接相关的工单号",
      "items": {
        "type": "string"
      }
    }
  }
}
